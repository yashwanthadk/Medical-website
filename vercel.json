{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.ts": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index?__vercel_path=/api/$1"
    },
    {
      "source": "/health",
      "destination": "/api/index?__vercel_path=/health"
    },
    {
      "source": "/ready",
      "destination": "/api/index?__vercel_path=/ready"
    },
    {
      "source": "/((?!api/|assets/|src/).*)",
      "destination": "/index.html"
    }
  ]
}
