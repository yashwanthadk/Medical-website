# GEMINI_API_KEY: Required for Gemini AI API calls (set in Vercel Project Settings > Environment Variables).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# SESSION_SECRET: Long random secret used to sign JWT sessions (required in production on Vercel).
SESSION_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_STRING"

# DATABASE_URL: Optional PostgreSQL connection string (e.g., Neon, Supabase, Vercel Postgres) for durable multi-instance persistence on Vercel.
# If omitted, the server uses local SQLite (AI Studio / Node) or /tmp SQLite (ephemeral fallback).
DATABASE_URL=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# VITE_API_BASE_URL: Optional frontend API origin override when frontend and backend are hosted on separate domains.
# Leave empty when frontend and /api serverless functions are hosted together on Vercel or AI Studio.
VITE_API_BASE_URL=""

# MAX_UPLOAD_SIZE_MB: Maximum allowed medical file upload size in megabytes (Vercel serverless enforces ~4.5 MB request payload limit).
MAX_UPLOAD_SIZE_MB="20"
